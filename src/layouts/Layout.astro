---
import "../styles.css";

interface Props {
  title: string;
  wide?: boolean;
}
const { title, wide = false } = Astro.props;
const here = Astro.url.pathname;
const links = [
  { href: "/plan", label: "My plan" },
  { href: "/", label: "Degrees" },
  { href: "/readme/", label: "About" },
];
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body>
    <header class="site">
      <a class="brand" href="/plan">Degree planner</a>
      <nav aria-label="site">
        {links.map((l) => <a href={l.href} aria-current={here === l.href || (l.href !== "/" && here.startsWith(l.href)) ? "page" : undefined}>{l.label}</a>)}
      </nav>
    </header>
    <main class:list={{ wide }}>
      <slot />
    </main>
  </body>
</html>
