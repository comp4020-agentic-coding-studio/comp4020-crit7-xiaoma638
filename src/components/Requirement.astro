---
import { percent, progressText, tone, toneLabel } from "../lib/format";
import type { Result } from "../lib/rules";

interface Props {
  result: Result;
  titles: Map<string, string>;
}
const { result: r, titles } = Astro.props;
const t = tone(r);
const shownMissing = r.missing.slice(0, 6);
const shownChildren = r.kind === "choice" ? (r.children[0]?.children ?? []) : r.children;
const isPickList = r.kind === "courses" && r.measure === "units";
---

<li class={`req req-${t}`} data-requirement={r.id}>
  <div class="req-head">
    <span class={`badge badge-${t}`}>{toneLabel[t]}</span>
    <span class="req-label">{r.label}</span>
  </div>
  <div class="req-progress">{progressText(r)}</div>
  {
    r.status !== "choose" && r.status !== "manual" && r.required > 0 && (
      <div class="bar" aria-hidden="true">
        <span style={`width: ${percent(r)}%`} />
      </div>
    )
  }
  {
    r.options && (
      <form method="post" action="/api/plan/choices" class="choice">
        <input type="hidden" name="choice" value={r.id} />
        <label>
          <span class="visually-hidden">{r.label}</span>
          <select name="option">
            <option value="">— choose —</option>
            {r.options.map((o) => (
              <option value={o.id} selected={o.id === r.chosen}>
                {o.label}
              </option>
            ))}
          </select>
        </label>
        <button class="secondary">Save</button>
      </form>
    )
  }
  {r.note && <p class="note">{r.note}</p>}
  {
    shownMissing.length > 0 && (
      <div class="missing">
        <span class="missing-label">{isPickList ? "Choose from" : "Still needed"}</span>
        <ul>
          {shownMissing.map((entry) => {
            const [code, times] = entry.split(" ");
            return (
              <li>
                <a href={`/?q=${code}#add`} data-add={code} title={`${code} — add to plan`}>
                  {titles.get(code) ?? code}
                </a>
                {times && <span class="muted"> {times}</span>}
              </li>
            );
          })}
        </ul>
        {r.missing.length > shownMissing.length && <span class="muted">and {r.missing.length - shownMissing.length} more</span>}
      </div>
    )
  }
  {
    shownChildren.length > 0 && (
      <ul class="reqs">
        {shownChildren.map((child) => (
          <Astro.self result={child} titles={titles} />
        ))}
      </ul>
    )
  }
</li>
