---
import DegreePicker from "../components/DegreePicker.astro";
import Requirement from "../components/Requirement.astro";
import Layout from "../layouts/Layout.astro";
import {
  courseInfo,
  type Degree,
  getChoices,
  getDegree,
  listDegrees,
  listPlanCourses,
  loadTree,
  type Plan,
  termsFor,
} from "../lib/db";
import { audit, type RuleNode } from "../lib/rules";
import { COURSE_CODE } from "../lib/seed";
import { currentPlan } from "../lib/session";

const SESSION_ORDER = ["Summer", "S1", "Winter", "S2"];
const byTerm = (a: string, b: string) => {
  const [ya, sa] = a.split(" ");
  const [yb, sb] = b.split(" ");
  return Number(ya) - Number(yb) || SESSION_ORDER.indexOf(sa) - SESSION_ORDER.indexOf(sb);
};

const plan = currentPlan(Astro.cookies);
const degree = plan && getDegree(plan.degreeCode);

function build(plan: Plan, degree: Degree) {
  const tree = loadTree(degree.code);
  const planned = listPlanCourses(plan.id).sort((a, b) => byTerm(a.term, b.term) || a.id - b.id);
  const { results, duplicates } = audit(
    tree,
    planned.map((c) => ({ key: String(c.id), code: c.courseCode, units: c.units })),
    getChoices(plan.id),
  );
  const duplicate = new Set(duplicates);

  const terms = termsFor(plan, degree);
  const regular = terms.filter((t) => {
    const [year, session] = t.split(" ");
    return (session === "S1" || session === "S2") && Number(year) < plan.startYear + degree.durationYears;
  });
  // any term that holds a course is shown, even one from before the plan's start
  const used = new Set(planned.map((c) => c.term));
  const shown = [...new Set([...regular, ...used])].sort(byTerm);

  const listed = new Set<string>();
  const walk = (nodes: RuleNode[]) => {
    for (const n of nodes) {
      if (n.kind === "courses") n.courses.forEach((c) => listed.add(c.code));
      if (n.kind === "group") walk(n.children);
      if (n.kind === "choice") walk(n.options);
    }
  };
  walk(tree);
  const info = courseInfo([...new Set([...listed, ...planned.map((c) => c.courseCode)])]);
  const titles = new Map([...info].map(([code, i]) => [code, i.title]));

  // upper limits aren't goals: respecting one achieves nothing, breaking one is a problem
  const isLimit = (r: (typeof results)[number]) => r.kind === "constraint" && r.bound === "max";
  const top = results.filter((r) => r.status !== "manual" && !isLimit(r));
  const met = top.filter((r) => r.status === "met").length;
  const broken = results.filter((r) => isLimit(r) && r.status === "unmet").length;
  const units = planned.filter((c) => !duplicate.has(String(c.id))).reduce((n, c) => n + c.units, 0);

  const nextTerm = shown.find((t) => planned.filter((c) => c.term === t).reduce((n, c) => n + c.units, 0) < 24) ?? shown[0];
  const prefill = Astro.url.searchParams.get("add")?.toUpperCase() ?? "";
  return {
    results,
    terms,
    shown,
    planned,
    duplicate,
    titles,
    info,
    met,
    total: top.length,
    broken,
    units,
    complete: results.every((r) => r.status === "met" || r.status === "manual" || r.status === "within"),
    nextTerm,
    prefill: COURSE_CODE.test(prefill) ? prefill : "",
  };
}
const view = plan && degree ? build(plan, degree) : undefined;
const error = Astro.url.searchParams.get("error");
const degrees = listDegrees();
const rulesYear = degrees[0]?.year;
---

<Layout title={degree ? `${degree.name} plan — Degree planner` : "Degree planner"} wide>
  {
    !view || !degree || !plan ? (
      <div class="start">
        <h1>Plan an ANU computing degree</h1>
        <p class="lede">
          Pick your degree, then add courses to semesters. After every change the planner shows which requirements you've met
          and what's still missing.
        </p>
        <DegreePicker degrees={degrees} />
        <p class="muted">
          Every degree here follows the {rulesYear} rules from ANU Programs and Courses, so plans start in {rulesYear} Semester
          1. If you started earlier, your own rules may differ — check the P&C page for your commencement year.
        </p>
      </div>
    ) : (
      <>
        <div class="plan-head">
          <DegreePicker degrees={degrees} current={degree.code} />
          <h1>{degree.name}</h1>
          <p class="muted">
            {degree.code} · semesters from {plan.startYear} · rules from{" "}
            <a href={degree.sourceUrl} rel="external">
              ANU Programs and Courses {degree.year}
            </a>
            {" "}· switching degree keeps your courses
          </p>
          <p role="status">
            <a href="#requirements" class={`summary ${view.complete ? "summary-done" : ""}`}>
              {view.complete
                ? `All checkable requirements met — ${view.units} units planned`
                : `${view.met} of ${view.total} requirements met · ${view.units}/${degree.totalUnits} units planned${view.broken ? ` · ${view.broken} limit exceeded` : ""}`}
            </a>
          </p>
        </div>

        {error && (
          <p class="error" role="alert">
            {error}
          </p>
        )}

        <div class="plan-grid">
          <section aria-labelledby="requirements" class="requirements">
            <h2 id="requirements">Degree requirements</h2>
            <ul class="reqs">
              {view.results.map((r) => (
                <Requirement result={r} titles={view.titles} />
              ))}
            </ul>
            {degree.notes && (
              <details class="notes">
                <summary>What this planner doesn't check</summary>
                <ul>
                  {degree.notes.split("\n").map((n) => (
                    <li>{n}</li>
                  ))}
                </ul>
              </details>
            )}
          </section>
          <form method="post" action="/api/plan/courses" class="add" id="add" aria-label="Add a course">
              <label>
                Course code
                <input
                  name="code"
                  required
                  list="known-courses"
                  placeholder="COMP1100"
                  value={view.prefill}
                  autocomplete="off"
                  pattern="[A-Za-z]{4}\s*[0-9]{4}"
                  autofocus={view.prefill !== "" || undefined}
                />
              </label>
              <label>
                Semester
                <select name="term">
                  {view.terms.map((t) => (
                    <option selected={t === view.nextTerm}>{t}</option>
                  ))}
                </select>
              </label>
              <label>
                Units
                <input name="units" inputmode="numeric" size="3" placeholder="auto" title="Leave blank to use the course's published units" />
              </label>
              <button>Add course</button>
              <datalist id="known-courses">
                {[...view.info].map(([code, i]) => (
                  <option value={code}>{i.title}</option>
                ))}
              </datalist>
            </form>
          <section aria-labelledby="semesters" class="semesters">
            <h2 id="semesters">Semesters</h2>
            <div class="terms">
              {view.shown.map((term) => {
                const here = view.planned.filter((c) => c.term === term);
                const load = here.reduce((n, c) => n + c.units, 0);
                return (
                  <section class="term" aria-label={term}>
                    <h3>
                      {term} <span class="muted">{load} units</span>
                    </h3>
                    {here.length === 0 ? (
                      <p class="muted empty">No courses yet</p>
                    ) : (
                      <ul class="courses">
                        {here.map((c) => (
                          <li data-course={c.courseCode} data-duplicate={view.duplicate.has(String(c.id)) ? "" : undefined}>
                            <span>
                              <strong>{c.courseCode}</strong>
                              {view.titles.get(c.courseCode) && <span class="course-title">{view.titles.get(c.courseCode)}</span>}
                              {view.duplicate.has(String(c.id)) && (
                                <span class="course-warning">Already planned earlier — doesn't count again</span>
                              )}
                            </span>
                            <span class="muted">{c.units}u</span>
                            <form method="post" action="/api/plan/courses/delete">
                              <input type="hidden" name="id" value={c.id} />
                              <button class="remove" aria-label={`Remove ${c.courseCode} from ${term}`}>
                                ×
                              </button>
                            </form>
                          </li>
                        ))}
                      </ul>
                    )}
                  </section>
                );
              })}
            </div>
          </section>
        </div>
      </>
    )
  }
</Layout>

<script>
  // Progressive enhancement; every link and form works without it.
  const key = "plan-scroll";
  // After a form round-trip, land where the student was, not at the top.
  try {
    const saved = sessionStorage.getItem(key);
    if (saved !== null) {
      sessionStorage.removeItem(key);
      window.scrollTo(0, Number(saved));
    }
  } catch {}
  document.addEventListener("submit", () => {
    try {
      sessionStorage.setItem(key, String(window.scrollY));
    } catch {}
  });

  // Picking a suggested course fills the add form in place instead of navigating.
  const form = document.querySelector<HTMLFormElement>("#add");
  const input = form?.querySelector<HTMLInputElement>('input[name="code"]');
  document.addEventListener("click", (event) => {
    const link = (event.target as Element).closest<HTMLAnchorElement>("a[data-add]");
    if (!link || !form || !input) return;
    event.preventDefault();
    input.value = link.dataset.add ?? "";
    input.focus({ preventScroll: true });
    form.classList.remove("flash");
    void form.offsetWidth;
    form.classList.add("flash");
  });
</script>
