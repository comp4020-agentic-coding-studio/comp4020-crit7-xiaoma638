---
import DegreePicker from "../components/DegreePicker.astro";
import Requirement from "../components/Requirement.astro";
import ResultRow from "../components/ResultRow.astro";
import Layout from "../layouts/Layout.astro";
import {
  allCourses,
  type Degree,
  getChoices,
  getDegree,
  listDegrees,
  listPlanCourses,
  loadTree,
  type Plan,
  searchCourses,
  termsFor,
} from "../lib/db";
import { category, shortPath } from "../lib/format";
import { courseFits, describeFit, nextSteps } from "../lib/fit";
import { audit } from "../lib/rules";
import { currentPlan } from "../lib/session";

const SESSION_ORDER = ["Summer", "S1", "Winter", "S2"];
const byTerm = (a: string, b: string) => {
  const [ya, sa] = a.split(" ");
  const [yb, sb] = b.split(" ");
  return Number(ya) - Number(yb) || SESSION_ORDER.indexOf(sa) - SESSION_ORDER.indexOf(sb);
};

const plan = currentPlan(Astro.cookies);
const degree = plan && getDegree(plan.degreeCode);

function build(plan: Plan, degree: Degree) {
  const tree = loadTree(degree.code);
  const planned = listPlanCourses(plan.id).sort((a, b) => byTerm(a.term, b.term) || a.id - b.id);
  const { results: audited, duplicates, countedBy } = audit(
    tree,
    planned.map((c) => ({ key: String(c.id), code: c.courseCode, units: c.units })),
    getChoices(plan.id),
  );
  const duplicate = new Set(duplicates);

  const terms = termsFor(plan, degree);
  const regular = terms.filter((t) => {
    const [year, session] = t.split(" ");
    return (session === "S1" || session === "S2") && Number(year) < plan.startYear + degree.durationYears;
  });
  // any term that holds a course is shown, even one from before the plan's start
  const used = new Set(planned.map((c) => c.term));
  const shown = [...new Set([...regular, ...used])].sort(byTerm);

  const choices = getChoices(plan.id);
  const fits = courseFits(tree, choices);
  const catalogue = allCourses().map((c) => {
    const fit = fits.get(c.code);
    return { ...c, fitKind: fit?.kind ?? "other", fitText: describeFit(fit, degree.code) };
  });
  const titles = new Map(catalogue.map((c) => [c.code, c.title]));
  const query = Astro.url.searchParams.get("q")?.trim() ?? "";
  const hits = query ? new Set(searchCourses(query).map((c) => c.code)) : new Set<string>();
  const found = catalogue.filter((c) => hits.has(c.code));
  const results = {
    inDegree: found.filter((c) => c.fitKind !== "other").sort((a, b) => Number(a.fitKind !== "counts") - Number(b.fitKind !== "counts")).slice(0, 10),
    other: found.filter((c) => c.fitKind === "other").slice(0, 6),
  };

  // upper limits aren't goals: respecting one achieves nothing, breaking one is a problem
  const completion = audited.filter((r) => category(r) === "completion");
  const groups = {
    missing: completion.filter((r) => r.status !== "met"),
    met: completion.filter((r) => r.status === "met"),
    limits: audited.filter((r) => category(r) === "limit"),
    manual: audited.filter((r) => category(r) === "manual"),
  };
  const met = groups.met.length;
  const steps = nextSteps(audited);
  const broken = groups.limits.filter((r) => r.status === "unmet").length;
  const units = planned.filter((c) => !duplicate.has(String(c.id))).reduce((n, c) => n + c.units, 0);

  const askedTerm = Astro.url.searchParams.get("term");
  const nextTerm = (askedTerm && terms.includes(askedTerm) ? askedTerm : undefined) ?? shown.find((t) => planned.filter((c) => c.term === t).reduce((n, c) => n + c.units, 0) < 24) ?? shown[0];
  return {
    groups,
    steps,
    terms,
    shown,
    planned,
    duplicate,
    countsToward: (id: number) => {
      const path = countedBy.get(String(id));
      return path && shortPath(path);
    },
    titles,
    catalogue,
    query,
    results,
    met,
    total: completion.length,
    broken,
    units,
    complete: groups.missing.length === 0 && broken === 0,
    nextTerm,
  };
}
const view = plan && degree ? build(plan, degree) : undefined;
const error = Astro.url.searchParams.get("error");
const degrees = listDegrees();
const rulesYear = degrees[0]?.year;
---

<Layout title={degree ? `${degree.name} plan — Degree planner` : "Degree planner"} wide>
  {
    !view || !degree || !plan ? (
      <div class="start">
        <h1>Plan an ANU computing degree</h1>
        <p class="lede">
          Pick your degree, then add courses to semesters. After every change the planner shows which requirements you've met
          and what's still missing.
        </p>
        <DegreePicker degrees={degrees} />
        <p class="muted">
          Every degree here follows the {rulesYear} rules from ANU Programs and Courses, so plans start in {rulesYear} Semester
          1. If you started earlier, your own rules may differ — check the P&C page for your commencement year.
        </p>
      </div>
    ) : (
      <>
        <header class="plan-head">
          <DegreePicker degrees={degrees} current={degree.code} />
          <h1>{degree.name}</h1>
          <p class="muted meta">
            {degree.code} · {degree.year} rules from{" "}
            <a href={degree.sourceUrl} rel="external">
              ANU Programs and Courses
            </a>
            {" "}· switching degree keeps your courses
          </p>
          <p class="summary" role="status">
            <a href="#audit" class={`stat ${view.complete ? "stat-met" : "stat-missing"}`}>
              <strong>
                {view.met} of {view.total}
              </strong>{" "}
              requirements met
            </a>
            <span class="visually-hidden">, </span>
            <span class="stat">
              <strong>
                {view.units}/{degree.totalUnits}
              </strong>{" "}
              units
            </span>
            <span class="visually-hidden">, </span>
            <a href="#audit" class={`stat ${view.broken ? "stat-over" : ""}`}>
              {view.broken ? `${view.broken} limit exceeded` : "limits OK"}
            </a>
            {view.groups.manual.length > 0 && <span class="visually-hidden">, </span>}
            {view.groups.manual.length > 0 && (
              <a href="#audit" class="stat">
                {view.groups.manual.length} to check yourself
              </a>
            )}
          </p>
        </header>

        {error && (
          <p class="error" role="alert">
            {error}
          </p>
        )}

        <div class="planner">
            <section class="add" id="add" aria-labelledby="add-heading">
              <h2 id="add-heading">Add a course</h2>
              <form method="get" action="/#add" class="search" role="search">
                <label for="q" class="visually-hidden">Search courses by code or name</label>
                <input
                  id="q"
                  name="q"
                  type="search"
                  value={view.query}
                  placeholder="Search by code or name, e.g. COMP3600 or algorithms"
                  autocomplete="off"
                  aria-controls="results"
                  aria-describedby="checks"
                />
                <input type="hidden" name="term" value={view.nextTerm} />
                <button class="secondary">Search</button>
              </form>
              <div id="results" class="results" aria-live="polite">
                {view.query &&
                  (view.results.inDegree.length + view.results.other.length === 0 ? (
                    <p class="no-results">No course matches “{view.query}”. If it's a real ANU course, add it by code below.</p>
                  ) : (
                    <>
                      {view.results.inDegree.length > 0 && (
                        <>
                          <h3 class="results-heading">In your degree</h3>
                          <ul class="result-list">
                            {view.results.inDegree.map((c) => (
                              <ResultRow {...c} terms={view.terms} term={view.nextTerm} />
                            ))}
                          </ul>
                        </>
                      )}
                      {view.results.other.length > 0 && (
                        <>
                          <h3 class="results-heading">Other courses</h3>
                          <ul class="result-list">
                            {view.results.other.map((c) => (
                              <ResultRow {...c} terms={view.terms} term={view.nextTerm} />
                            ))}
                          </ul>
                        </>
                      )}
                    </>
                  ))}
              </div>
              <details class="custom">
                <summary>Course not listed? Add it by code</summary>
                <form method="post" action="/api/plan/courses" class="custom-form">
                  <label>
                    Code
                    <input name="code" required pattern="[A-Za-z]{4}\s*[0-9]{4}" placeholder="ECON1101" autocomplete="off" />
                  </label>
                  <label>
                    Semester
                    <select name="term">
                      {view.terms.map((t) => (
                        <option selected={t === view.nextTerm}>{t}</option>
                      ))}
                    </select>
                  </label>
                  <label>
                    Units
                    <input name="units" inputmode="numeric" value="6" size="3" />
                  </label>
                  <button class="secondary">Add</button>
                </form>
              </details>
              <p class="checks" id="checks">
                <span class="tag">Not checked</span> semester offerings, prerequisites and timetable clashes. Confirm them on
                Programs and Courses and the ANU timetable before you enrol.
              </p>
              <template id="result-template">
                <ResultRow code="CODE0000" title="" units={0} fitKind="other" fitText="" terms={view.terms} term={view.nextTerm} />
              </template>
              <script
                type="application/json"
                id="catalogue"
                set:html={JSON.stringify(view.catalogue.map((c) => [c.code, c.title, c.units, c.fitKind, c.fitText])).replace(/</g, "\\u003c")}
              />
            </section>

            <section class="next" aria-labelledby="next-heading">
              <h2 id="next-heading">Next steps</h2>
              {view.steps.length === 0 ? (
                <p class="all-done">Every requirement the planner can check is met. Review the manual checks in the full audit.</p>
              ) : (
                <ol class="steps">
                  {view.steps.map((step) => (
                    <li>
                      <span class="step-text">{step.text}</span>
                      {step.codes.length > 0 && (
                        <span class="chips">
                          {step.codes.map((code) => (
                            <a href={`/?q=${code}#add`} data-add={code} title={code}>
                              {view.titles.get(code) ?? code}
                            </a>
                          ))}
                        </span>
                      )}
                    </li>
                  ))}
                </ol>
              )}
              <a href="#audit" class="view-audit" data-open-audit>
                View full degree audit
              </a>
            </section>

            <section aria-labelledby="semesters" class="semesters">
              <h2 id="semesters">Semester plan</h2>
              <div class="terms">
                {view.shown.map((term) => {
                  const here = view.planned.filter((c) => c.term === term);
                  const load = here.filter((c) => !view.duplicate.has(String(c.id))).reduce((n, c) => n + c.units, 0);
                  return (
                    <section class="term" aria-label={term}>
                      <h3>
                        <span>{term}</span>
                        <span class="term-load">{load} units</span>
                      </h3>
                      {here.length === 0 ? (
                        <p class="empty">Nothing planned</p>
                      ) : (
                        <ul class="courses">
                          {here.map((c) => {
                            const dup = view.duplicate.has(String(c.id));
                            const counts = view.countsToward(c.id);
                            return (
                              <li class="course" data-course={c.courseCode} data-duplicate={dup ? "" : undefined}>
                                <div class="course-main">
                                  <div class="course-head">
                                    <strong>{c.courseCode}</strong>
                                    <span class="units">{c.units}u</span>
                                  </div>
                                  {view.titles.get(c.courseCode) && <div class="course-title">{view.titles.get(c.courseCode)}</div>}
                                  {dup ? (
                                    <div class="course-warning">Already planned earlier — doesn't count again</div>
                                  ) : counts ? (
                                    <div class="counts" data-counts>
                                      Counts toward {counts}
                                    </div>
                                  ) : (
                                    <div class="counts counts-none" data-counts>
                                      Not counted toward any requirement
                                    </div>
                                  )}
                                </div>
                                <div class="course-actions">
                                  <form method="post" action="/api/plan/courses/move" class="move">
                                    <input type="hidden" name="id" value={c.id} />
                                    <label>
                                      <span class="visually-hidden">Move {c.courseCode} to</span>
                                      <select name="term">
                                        {view.terms.map((t) => (
                                          <option selected={t === term}>{t}</option>
                                        ))}
                                      </select>
                                    </label>
                                    <button class="secondary">Move</button>
                                  </form>
                                  <form method="post" action="/api/plan/courses/delete">
                                    <input type="hidden" name="id" value={c.id} />
                                    <button class="remove" aria-label={`Remove ${c.courseCode} from ${term}`}>
                                      Remove
                                    </button>
                                  </form>
                                </div>
                              </li>
                            );
                          })}
                        </ul>
                      )}
                    </section>
                  );
                })}
              </div>
            </section>

          <aside class="audit" aria-labelledby="audit-heading">
            <details id="audit">
              <summary>
                <h2 id="audit-heading">Full degree audit</h2>
                <span class="muted">
                  {view.met}/{view.total} met
                </span>
              </summary>
              {[
                { key: "missing", title: "Missing", list: view.groups.missing, open: true },
                { key: "met", title: "Met", list: view.groups.met, open: false },
                { key: "limits", title: "Limits", list: view.groups.limits, open: view.broken > 0 },
                { key: "manual", title: "Check yourself", list: view.groups.manual, open: false },
              ].map(
                (g) =>
                  g.list.length > 0 && (
                    <details class={`audit-group audit-${g.key}`} open={g.open}>
                      <summary>
                        {g.title} <span class="count">{g.list.length}</span>
                      </summary>
                      <ul class="reqs">
                        {g.list.map((r) => (
                          <Requirement result={r} titles={view.titles} />
                        ))}
                      </ul>
                    </details>
                  ),
              )}
              {degree.notes && (
                <details class="audit-group notes">
                  <summary>What this planner doesn't check</summary>
                  <ul>
                    {degree.notes.split("\n").map((n) => (
                      <li>{n}</li>
                    ))}
                  </ul>
                </details>
              )}
            </details>
          </aside>
        </div>
      </>
    )
  }
</Layout>

<script>
  // Progressive enhancement; every link and form works without it.
  const key = "plan-scroll";
  // After a form round-trip, land where the student was, not at the top.
  try {
    const saved = sessionStorage.getItem(key);
    if (saved !== null) {
      sessionStorage.removeItem(key);
      window.scrollTo(0, Number(saved));
    }
  } catch {}
  document.addEventListener("submit", () => {
    try {
      sessionStorage.setItem(key, String(window.scrollY));
    } catch {}
  });

  // The full audit starts collapsed; links to it open it.
  const auditPanel = document.querySelector<HTMLDetailsElement>("#audit");
  if (auditPanel && location.hash === "#audit") auditPanel.open = true;
  for (const link of document.querySelectorAll('a[href="#audit"]')) {
    link.addEventListener("click", () => auditPanel && (auditPanel.open = true));
  }

  // Picking another semester moves the course straight away.
  for (const move of document.querySelectorAll<HTMLFormElement>("form.move")) {
    move.querySelector("select")?.addEventListener("change", () => move.requestSubmit());
    move.querySelector("button")?.classList.add("js-hidden");
  }

  // Live search over the course catalogue embedded in the page; rows are clones
  // of the server-rendered template, so they post exactly like server results.
  const addPanel = document.querySelector<HTMLElement>("#add");
  const search = document.querySelector<HTMLInputElement>("#q");
  const resultsEl = document.querySelector<HTMLElement>("#results");
  const template = document.querySelector<HTMLTemplateElement>("#result-template");
  type Entry = [code: string, title: string, units: number, fitKind: string, fitText: string];
  const catalogue: Entry[] = JSON.parse(document.querySelector("#catalogue")?.textContent ?? "[]");
  let defaultTerm = document.querySelector<HTMLInputElement>('.search input[name="term"]')?.value ?? "";

  const row = ([code, title, units, fitKind, fitText]: Entry) => {
    const li = template?.content.firstElementChild?.cloneNode(true) as HTMLElement;
    const set = (f: string, text: string) => {
      const el = li.querySelector<HTMLElement>(`[data-f="${f}"]`);
      if (el) el.textContent = text;
    };
    li.dataset.result = code;
    set("code", code);
    set("title", title);
    set("units", `${units}u`);
    set("fit", fitText);
    li.querySelector('[data-f="fit"]')!.className = `fit fit-${fitKind}`;
    li.querySelector<HTMLInputElement>('[data-f="input"]')!.value = code;
    li.querySelector<HTMLAnchorElement>('[data-f="link"]')!.href = `https://programsandcourses.anu.edu.au/2027/course/${code}`;
    const select = li.querySelector("select");
    if (select) select.value = defaultTerm;
    return li;
  };

  const group = (heading: string, entries: Entry[]) => {
    if (!entries.length) return [];
    const h = document.createElement("h3");
    h.className = "results-heading";
    h.textContent = heading;
    const ul = document.createElement("ul");
    ul.className = "result-list";
    ul.append(...entries.map(row));
    return [h, ul];
  };

  const render = () => {
    if (!search || !resultsEl) return;
    const words = search.value.toLowerCase().split(/\s+/).filter(Boolean);
    if (!words.length) {
      resultsEl.replaceChildren();
      return;
    }
    const hits = catalogue.filter(([code, title]) => words.every((w) => `${code} ${title}`.toLowerCase().includes(w)));
    const inDegree = hits.filter((e) => e[3] !== "other").sort((a, b) => Number(a[3] !== "counts") - Number(b[3] !== "counts"));
    const other = hits.filter((e) => e[3] === "other");
    if (!hits.length) {
      const p = document.createElement("p");
      p.className = "no-results";
      p.textContent = `No course matches “${search.value.trim()}”. If it's a real ANU course, add it by code below.`;
      resultsEl.replaceChildren(p);
      return;
    }
    resultsEl.replaceChildren(...group("In your degree", inDegree.slice(0, 8)), ...group("Other courses", other.slice(0, 5)));
  };
  search?.addEventListener("input", render);

  const focusSearch = (text?: string) => {
    if (!search || !addPanel) return;
    if (text !== undefined) {
      search.value = text;
      render();
    }
    search.focus({ preventScroll: true });
    const box = addPanel.getBoundingClientRect();
    if (box.top < 0 || box.bottom > window.innerHeight) addPanel.scrollIntoView({ behavior: "smooth", block: "start" });
    addPanel.classList.remove("flash");
    void addPanel.offsetWidth;
    addPanel.classList.add("flash");
  };

  // a suggested course (audit, next steps) opens its search result in place
  document.addEventListener("click", (event) => {
    const target = event.target as Element;
    const suggestion = target.closest<HTMLAnchorElement>("a[data-add]");
    if (suggestion) {
      event.preventDefault();
      focusSearch(suggestion.dataset.add ?? "");
      return;
    }
    // "+ Add a course" on a semester card: search, adding to that semester
    const termLink = target.closest<HTMLAnchorElement>("a[data-term]");
    if (termLink) {
      event.preventDefault();
      defaultTerm = termLink.dataset.term ?? defaultTerm;
      for (const select of document.querySelectorAll<HTMLSelectElement>(".result-add select, .custom-form select")) select.value = defaultTerm;
      focusSearch();
    }
  });
</script>
