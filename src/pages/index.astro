---
import DegreePicker from "../components/DegreePicker.astro";
import Requirement from "../components/Requirement.astro";
import Layout from "../layouts/Layout.astro";
import {
  allCourses,
  type Degree,
  getChoices,
  getDegree,
  listDegrees,
  listPlanCourses,
  loadTree,
  type Plan,
  searchCourses,
  termsFor,
} from "../lib/db";
import { audit, type RuleNode } from "../lib/rules";
import { COURSE_CODE } from "../lib/seed";
import { currentPlan } from "../lib/session";

const SESSION_ORDER = ["Summer", "S1", "Winter", "S2"];
const byTerm = (a: string, b: string) => {
  const [ya, sa] = a.split(" ");
  const [yb, sb] = b.split(" ");
  return Number(ya) - Number(yb) || SESSION_ORDER.indexOf(sa) - SESSION_ORDER.indexOf(sb);
};

const plan = currentPlan(Astro.cookies);
const degree = plan && getDegree(plan.degreeCode);

function build(plan: Plan, degree: Degree) {
  const tree = loadTree(degree.code);
  const planned = listPlanCourses(plan.id).sort((a, b) => byTerm(a.term, b.term) || a.id - b.id);
  const { results, duplicates, countedBy } = audit(
    tree,
    planned.map((c) => ({ key: String(c.id), code: c.courseCode, units: c.units })),
    getChoices(plan.id),
  );
  const duplicate = new Set(duplicates);

  const terms = termsFor(plan, degree);
  const regular = terms.filter((t) => {
    const [year, session] = t.split(" ");
    return (session === "S1" || session === "S2") && Number(year) < plan.startYear + degree.durationYears;
  });
  // any term that holds a course is shown, even one from before the plan's start
  const used = new Set(planned.map((c) => c.term));
  const shown = [...new Set([...regular, ...used])].sort(byTerm);

  // where each course is named in this degree's rules, for search results
  const listedIn = new Map<string, string>();
  const walk = (nodes: RuleNode[], path: string[]) => {
    for (const n of nodes) {
      const here = [...path, n.label];
      if (n.kind === "courses") {
        const where = here.length > 1 ? `${here[0]} › ${here[here.length - 1]}` : here[0];
        for (const c of n.courses) if (!listedIn.has(c.code)) listedIn.set(c.code, where);
      }
      if (n.kind === "group") walk(n.children, here);
      if (n.kind === "choice") walk(n.options, here);
    }
  };
  walk(tree, []);
  const catalogue = allCourses().map((c) => ({ ...c, listed: listedIn.get(c.code) }));
  const titles = new Map(catalogue.map((c) => [c.code, c.title]));
  const query = Astro.url.searchParams.get("q")?.trim() ?? "";
  const matches = query
    ? searchCourses(query)
        .map((c) => ({ ...c, listed: listedIn.get(c.code) }))
        .sort((a, b) => Number(!a.listed) - Number(!b.listed))
        .slice(0, 12)
    : [];

  // upper limits aren't goals: respecting one achieves nothing, breaking one is a problem
  const isLimit = (r: (typeof results)[number]) => r.kind === "constraint" && r.bound === "max";
  const top = results.filter((r) => r.status !== "manual" && !isLimit(r));
  const met = top.filter((r) => r.status === "met").length;
  const broken = results.filter((r) => isLimit(r) && r.status === "unmet").length;
  const units = planned.filter((c) => !duplicate.has(String(c.id))).reduce((n, c) => n + c.units, 0);

  const askedTerm = Astro.url.searchParams.get("term");
  const nextTerm = (askedTerm && terms.includes(askedTerm) ? askedTerm : undefined) ?? shown.find((t) => planned.filter((c) => c.term === t).reduce((n, c) => n + c.units, 0) < 24) ?? shown[0];
  const prefill = Astro.url.searchParams.get("add")?.toUpperCase() ?? "";
  return {
    results,
    terms,
    shown,
    planned,
    duplicate,
    countsToward: (id: number) => {
      const path = countedBy.get(String(id));
      if (!path) return undefined;
      return path.length > 1 ? `${path[0]} › ${path[path.length - 1]}` : path[0];
    },
    titles,
    catalogue,
    query,
    matches,
    met,
    total: top.length,
    broken,
    units,
    complete: results.every((r) => r.status === "met" || r.status === "manual" || r.status === "within"),
    nextTerm,
    prefill: COURSE_CODE.test(prefill) ? prefill : "",
  };
}
const view = plan && degree ? build(plan, degree) : undefined;
const error = Astro.url.searchParams.get("error");
const degrees = listDegrees();
const rulesYear = degrees[0]?.year;
---

<Layout title={degree ? `${degree.name} plan — Degree planner` : "Degree planner"} wide>
  {
    !view || !degree || !plan ? (
      <div class="start">
        <h1>Plan an ANU computing degree</h1>
        <p class="lede">
          Pick your degree, then add courses to semesters. After every change the planner shows which requirements you've met
          and what's still missing.
        </p>
        <DegreePicker degrees={degrees} />
        <p class="muted">
          Every degree here follows the {rulesYear} rules from ANU Programs and Courses, so plans start in {rulesYear} Semester
          1. If you started earlier, your own rules may differ — check the P&C page for your commencement year.
        </p>
      </div>
    ) : (
      <>
        <div class="plan-head">
          <DegreePicker degrees={degrees} current={degree.code} />
          <h1>{degree.name}</h1>
          <p class="muted">
            {degree.code} · semesters from {plan.startYear} · rules from{" "}
            <a href={degree.sourceUrl} rel="external">
              ANU Programs and Courses {degree.year}
            </a>
            {" "}· switching degree keeps your courses
          </p>
          <p role="status">
            <a href="#requirements" class={`summary ${view.complete ? "summary-done" : ""}`}>
              {view.complete
                ? `All checkable requirements met — ${view.units} units planned`
                : `${view.met} of ${view.total} requirements met · ${view.units}/${degree.totalUnits} units planned${view.broken ? ` · ${view.broken} limit exceeded` : ""}`}
            </a>
          </p>
        </div>

        {error && (
          <p class="error" role="alert">
            {error}
          </p>
        )}

        <div class="plan-grid">
          <section aria-labelledby="requirements" class="requirements">
            <h2 id="requirements">Degree requirements</h2>
            <ul class="reqs">
              {view.results.map((r) => (
                <Requirement result={r} titles={view.titles} />
              ))}
            </ul>
            {degree.notes && (
              <details class="notes">
                <summary>What this planner doesn't check</summary>
                <ul>
                  {degree.notes.split("\n").map((n) => (
                    <li>{n}</li>
                  ))}
                </ul>
              </details>
            )}
          </section>
          <section class="add" id="add" aria-labelledby="add-heading">
            <h2 id="add-heading" class="visually-hidden">Add a course</h2>
            <form method="post" action="/api/plan/courses" class="add-form">
              <label class="course-field">
                Course
                <input
                  name="code"
                  required
                  placeholder="Code or name, e.g. COMP2100 or algorithms"
                  value={view.prefill || view.query}
                  autocomplete="off"
                  aria-describedby="add-hint"
                  aria-controls="suggest"
                  autofocus={view.prefill !== "" || undefined}
                />
              </label>
              <label>
                Semester
                <select name="term">
                  {view.terms.map((t) => (
                    <option selected={t === view.nextTerm}>{t}</option>
                  ))}
                </select>
              </label>
              <label>
                Units
                <input name="units" inputmode="numeric" size="3" placeholder="auto" title="Leave blank to use the course's published units" />
              </label>
              <button>Add</button>
            </form>
            <p id="add-hint" class="hint">Type a code to add it directly, or part of a name to search.</p>
            <ul id="suggest" class="suggest" hidden></ul>
            {view.query && (
              <div class="matches" role="region" aria-label="Search results">
                <p>
                  {view.matches.length} courses match “{view.query}” — pick one, then Add:
                </p>
                <ul class="suggest">
                  {view.matches.map((c) => (
                    <li>
                      <a href={`/?add=${c.code}#add`} data-add={c.code}>
                        <strong>{c.code}</strong> {c.title}
                      </a>
                      <span class="muted">
                        {c.units}u{c.listed ? ` · ${c.listed}` : ""}
                      </span>
                    </li>
                  ))}
                </ul>
              </div>
            )}
            <script
              type="application/json"
              id="catalogue"
              set:html={JSON.stringify(view.catalogue.map((c) => [c.code, c.title, c.units, c.listed ?? ""])).replace(/</g, "\\u003c")}
            />
          </section>
          <section aria-labelledby="semesters" class="semesters">
            <h2 id="semesters">Semesters</h2>
            <div class="terms">
              {view.shown.map((term) => {
                const here = view.planned.filter((c) => c.term === term);
                const load = here.reduce((n, c) => n + c.units, 0);
                return (
                  <section class="term" aria-label={term}>
                    <h3>
                      {term} <span class="muted">{load} units</span>
                    </h3>
                    {here.length === 0 ? (
                      <p class="muted empty">No courses yet</p>
                    ) : (
                      <ul class="courses">
                        {here.map((c) => (
                          <li data-course={c.courseCode} data-duplicate={view.duplicate.has(String(c.id)) ? "" : undefined}>
                            <span>
                              <strong>{c.courseCode}</strong>
                              {view.titles.get(c.courseCode) && <span class="course-title">{view.titles.get(c.courseCode)}</span>}
                              {view.duplicate.has(String(c.id)) ? (
                                <span class="course-warning">Already planned earlier — doesn't count again</span>
                              ) : view.countsToward(c.id) ? (
                                <span class="counts" data-counts>
                                  Counts toward {view.countsToward(c.id)}
                                </span>
                              ) : (
                                <span class="counts counts-none" data-counts>
                                  Not counted toward any requirement
                                </span>
                              )}
                            </span>
                            <span class="muted">{c.units}u</span>
                            <form method="post" action="/api/plan/courses/move" class="move">
                              <input type="hidden" name="id" value={c.id} />
                              <label>
                                <span class="visually-hidden">Move {c.courseCode} to</span>
                                <select name="term">
                                  {view.terms.map((t) => (
                                    <option selected={t === term}>{t}</option>
                                  ))}
                                </select>
                              </label>
                              <button>Move</button>
                            </form>
                            <form method="post" action="/api/plan/courses/delete">
                              <input type="hidden" name="id" value={c.id} />
                              <button class="remove" aria-label={`Remove ${c.courseCode} from ${term}`}>
                                ×
                              </button>
                            </form>
                          </li>
                        ))}
                      </ul>
                    )}
                  </section>
                );
              })}
            </div>
          </section>
        </div>
      </>
    )
  }
</Layout>

<script>
  // Progressive enhancement; every link and form works without it.
  const key = "plan-scroll";
  // After a form round-trip, land where the student was, not at the top.
  try {
    const saved = sessionStorage.getItem(key);
    if (saved !== null) {
      sessionStorage.removeItem(key);
      window.scrollTo(0, Number(saved));
    }
  } catch {}
  document.addEventListener("submit", () => {
    try {
      sessionStorage.setItem(key, String(window.scrollY));
    } catch {}
  });

  // Picking another semester moves the course straight away.
  for (const move of document.querySelectorAll<HTMLFormElement>("form.move")) {
    move.querySelector("select")?.addEventListener("change", () => move.requestSubmit());
    move.querySelector("button")?.classList.add("js-hidden");
  }

  // Picking a suggested course fills the add form in place instead of navigating.
  const form = document.querySelector<HTMLElement>("#add");
  const input = form?.querySelector<HTMLInputElement>('input[name="code"]');
  document.addEventListener("click", (event) => {
    const link = (event.target as Element).closest<HTMLAnchorElement>("a[data-add]");
    if (!link || !form || !input) return;
    event.preventDefault();
    input.value = link.dataset.add ?? "";
    input.focus({ preventScroll: true });
    form.classList.remove("flash");
    void form.offsetWidth;
    form.classList.add("flash");
  });

  // Live suggestions from the course catalogue embedded in the page.
  const suggest = document.querySelector<HTMLUListElement>("#suggest");
  const catalogueEl = document.querySelector("#catalogue");
  type Entry = [code: string, title: string, units: number, listed: string];
  const catalogue: Entry[] = catalogueEl ? JSON.parse(catalogueEl.textContent ?? "[]") : [];
  const render = () => {
    if (!input || !suggest) return;
    const words = input.value.toLowerCase().split(/\s+/).filter(Boolean);
    const exact = catalogue.some(([code]) => code === input.value.trim().toUpperCase());
    const hits = words.length && !exact
      ? catalogue
          .filter(([code, title]) => words.every((w) => `${code} ${title}`.toLowerCase().includes(w)))
          .sort((a, b) => Number(!a[3]) - Number(!b[3]))
          .slice(0, 8)
      : [];
    suggest.replaceChildren(
      ...hits.map(([code, title, units, listed]) => {
        const li = document.createElement("li");
        const a = document.createElement("a");
        a.href = `/?add=${code}#add`;
        a.dataset.add = code;
        const strong = document.createElement("strong");
        strong.textContent = code;
        a.append(strong, ` ${title}`);
        const meta = document.createElement("span");
        meta.className = "muted";
        meta.textContent = `${units}u${listed ? ` · ${listed}` : ""}`;
        li.append(a, meta);
        return li;
      }),
    );
    suggest.hidden = hits.length === 0;
  };
  input?.addEventListener("input", render);
  document.addEventListener("click", (event) => {
    if ((event.target as Element).closest("a[data-add]") && suggest) suggest.hidden = true;
  });
</script>
