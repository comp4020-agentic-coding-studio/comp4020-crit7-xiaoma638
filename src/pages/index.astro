---
import Layout from "../layouts/Layout.astro";
import { listDegrees } from "../lib/db";
import { currentPlan } from "../lib/session";

const plan = currentPlan(Astro.cookies);
const degrees = listDegrees();
const undergrad = degrees.filter((d) => /^[A-Z]/.test(d.code));
const postgrad = degrees.filter((d) => /^\d/.test(d.code));
const thisYear = new Date().getFullYear();
const years = Array.from({ length: 8 }, (_, i) => thisYear - 5 + i);
const selectedYear = plan?.startYear ?? thisYear;
---

<Layout title="Choose a degree — Degree planner">
  <h1>Plan an ANU computing degree</h1>
  <p class="lede">
    Pick your degree and the year you started. Add courses to semesters and the planner tells you, after every change, which
    requirements you've met and what's still missing — using the 2027 rules from ANU Programs and Courses.
  </p>
  {
    plan && (
      <p class="callout">
        You already have a plan. <a href="/plan">Go back to it</a>, or choose a different degree below — your courses come with
        you.
      </p>
    )
  }
  <form method="post" action="/api/plans" class="degree-form">
    {
      [
        { heading: "Undergraduate", list: undergrad },
        { heading: "Postgraduate", list: postgrad },
      ].map(
        (group) =>
          group.list.length > 0 && (
            <fieldset>
              <legend>{group.heading}</legend>
              {group.list.map((d) => (
                <label class="degree-option">
                  <input type="radio" name="degree" value={d.code} required checked={plan?.degreeCode === d.code} />
                  <span>
                    <strong>{d.name}</strong>
                    <span class="muted">
                      {d.code} · {d.totalUnits} units · {d.durationYears} {d.durationYears === 1 ? "year" : "years"}
                    </span>
                  </span>
                </label>
              ))}
            </fieldset>
          ),
      )
    }
    <label for="startYear">Year you started</label>
    <select id="startYear" name="startYear">
      {years.map((y) => <option value={y} selected={y === selectedYear}>{y}</option>)}
    </select>
    <button>{plan ? "Switch to this degree" : "Start planning"}</button>
  </form>
</Layout>
