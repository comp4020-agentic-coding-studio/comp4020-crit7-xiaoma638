---
import Layout from "../layouts/Layout.astro";
import { listDegrees } from "../lib/db";
import { currentPlan } from "../lib/session";

const plan = currentPlan(Astro.cookies);
const degrees = listDegrees();
const groups = [
  { label: "Undergraduate", list: degrees.filter((d) => /^[A-Z]/.test(d.code)) },
  { label: "Postgraduate", list: degrees.filter((d) => /^\d/.test(d.code)) },
].filter((g) => g.list.length > 0);
const rulesYear = degrees[0]?.year;
---

<Layout title="Choose a degree — Degree planner">
  <h1>Plan an ANU computing degree</h1>
  <p class="lede">
    Pick your degree, then add courses to semesters. After every change the planner shows which requirements you've met and
    what's still missing.
  </p>
  <p class="callout">
    Every degree here follows the <strong>{rulesYear}</strong> rules from ANU Programs and Courses, so plans start in {rulesYear}{" "}
    Semester 1. If you started earlier, your own rules may differ — check the P&C page for your commencement year.
  </p>
  {
    plan && (
      <p>
        You already have a plan. <a href="/plan">Go back to it</a>, or choose a different degree below — your courses come with
        you.
      </p>
    )
  }
  <form method="post" action="/api/plans" class="degree-form">
    <label for="degree">Degree</label>
    <select id="degree" name="degree" required>
      {!plan && <option value="">— choose a degree —</option>}
      {
        groups.map((g) => (
          <optgroup label={g.label}>
            {g.list.map((d) => (
              <option value={d.code} selected={plan?.degreeCode === d.code}>
                {d.name} ({d.code}, {d.totalUnits} units)
              </option>
            ))}
          </optgroup>
        ))
      }
    </select>
    <button>{plan ? "Switch to this degree" : "Start planning"}</button>
  </form>
</Layout>
